# Môi trường thực thi: development hoặc production
NODE_ENV=development

# Cổng lắng nghe máy chủ Express (mặc định 3000, Render tự động điền)
PORT=3000

# Trình xem dữ liệu lịch sử: json (lưu trên ổ cứng local) hoặc postgres (Supabase PostgreSQL Cloud)
DATA_BACKEND=json

# Chuỗi kết nối PostgreSQL từ Supabase (bắt buộc khi NODE_ENV=production hoặc DATA_BACKEND=postgres)
# KHÔNG ghi secret thật vào Git. Điền trong Render Dashboard Environment Variables.
DATABASE_URL=

# Tên miền (origin) hợp lệ cho CORS khi cần, để trống nếu phục vụ cùng domain (same-origin)
APP_ORIGIN=
